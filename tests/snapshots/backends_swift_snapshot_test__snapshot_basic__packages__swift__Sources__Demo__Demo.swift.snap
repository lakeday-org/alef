// Generated by alef. Do not edit by hand.
// swift-format-ignore-file

import Foundation
import RustBridge
/// A demo configuration struct.
public typealias Config = RustBridge.Config

/// Processing status.
public typealias Status = RustBridge.Status

/// Errors emitted by demo operations.
public enum DemoError: Swift.Error {
    /// Input validation failed.
    case invalidInput
    /// Processing encountered an error.
    case processingFailed
    /// Synthetic case raised when a Rust serde unit-enum raw value cannot
    /// be mapped to a known Swift case during DTO unmarshaling.
    case validation(message: String, source: String)
}

extension DemoError {
    init?(bridgeError error: RustBridge.AlefBridgeError) {
        let message = error.message().toString()
        let status = error.status()
        let retryAfterMs = error.retryAfterMs()
        _ = (message, status, retryAfterMs)
        switch error.kind().toString() {
        case "InvalidInput":
            self = .invalidInput
        case "ProcessingFailed":
            self = .processingFailed
        default:
            return nil
        }
    }

    public var kind: String {
        switch self {
        case .invalidInput: return "InvalidInput"
        case .processingFailed: return "ProcessingFailed"
        case .validation: return "Validation"
        }
    }
}

private func alefBridgeErrorField<T: Decodable>(_ error: RustBridge.AlefBridgeError, _ name: String, as: T.Type) throws -> T {
    let payload = try JSONDecoder().decode([String: String].self, from: Data(error.payload().toString().utf8))
    guard let json = payload[name] else {
        throw DecodingError.keyNotFound(AlefErrorPayloadKey(name), .init(codingPath: [], debugDescription: "Missing error payload field"))
    }
    return try JSONDecoder().decode(T.self, from: Data(json.utf8))
}

private struct AlefErrorPayloadKey: CodingKey {
    var stringValue: String
    var intValue: Int? { nil }
    init(_ value: String) { stringValue = value }
    init?(stringValue: String) { self.init(stringValue) }
    init?(intValue: Int) { return nil }
}

/// Converts an error that the Rust bridge throws into the typed Swift error. Any other error
/// passes through unchanged.
func alefTypedError(_ error: Error) -> Error {
    guard let bridgeError = error as? RustBridge.AlefBridgeError else { return error }
    switch bridgeError.errorType().toString() {
    case "DemoError": return (DemoError(bridgeError: bridgeError) as Error?) ?? error
    default: return error
    }
}

/// Runs a call into the Rust bridge and throws the typed Swift error when the call fails.
func alefBridgedCall<T>(_ body: () throws -> T) throws -> T {
    do {
        return try body()
    } catch {
        throw alefTypedError(error)
    }
}

/// Runs an `async` call into the Rust bridge and throws the typed Swift error when the call fails.
func alefBridgedCallAsync<T>(_ body: () async throws -> T) async throws -> T {
    do {
        return try await body()
    } catch {
        throw alefTypedError(error)
    }
}

// MARK: - Free-function Forwarders
// Re-export every public free function on the source Rust crate as a
// top-level `public func` on the host module so consumers do not need to
// `import RustBridge` directly. Forwarders take Swift-native parameter
// types and convert to the swift-bridge runtime types internally.

/// Process input and return a result.
public func process(input: String, count: UInt32) throws -> String {
        let _rb_input = RustString(input)
    return try alefBridgedCall { try RustBridge.process(_rb_input, count) }.toString()
}
// swift-bridge opaque type used across Task.detached boundaries — Rust type is Send + Sync.
extension RustBridge.Config: @unchecked Sendable {}
