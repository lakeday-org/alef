// Getters, functions and methods that return a list of opaque handles or strings. swift-bridge hands such a list back as
// a `RustVec`, and an element read from a `RustVec` by index points into the vector's own buffer
// without keeping the vector alive. These accessors move every element out of the vector first,
// so each element owns its storage and `result.items()[0].name()` is safe on a temporary.

extension RustVec {
    /// Moves every element out of the vector and returns them, in order, as owned values.
    func alefIntoOwnedArray() -> [T] {
        var owned: [T] = []
        owned.reserveCapacity(len())
        while let element = pop() {
            owned.append(element)
        }
        owned.reverse()
        return owned
    }
}
extension ProcessResultRef {    public func diagnostics() -> [RustString] {        self.__alef_owned_vec_diagnostics().alefIntoOwnedArray()    }
    public func tags() -> [RustString] {        self.__alef_owned_vec_tags().alefIntoOwnedArray()    }
