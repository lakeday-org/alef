        kind: "payload kind".into(), errorCode: "payload numeric code".into(),
        statusCode: "payload status".into(), stack: "payload stack".into(), cause: "payload cause".into(),
        constructor: "payload constructor".into(), toString: "payload stringifier".into(), payload: "nested raw payload".into(), obj: "raw obj".into(), message_value: "raw message_value".into(), details: "ordinary detail".into(),
