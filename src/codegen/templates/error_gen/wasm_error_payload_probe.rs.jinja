use wasm_bindgen::prelude::*;
mod sample_core {
    pub enum SampleError {
        Failure { message: String, name: String, code: String, kind: String, errorCode: String, statusCode: String, stack: String, cause: String, constructor: String, toString: String, payload: String, obj: String, message_value: String, details: String },
        Empty,
    }
    impl SampleError { pub fn status_code(&self) -> u16 { 429 } pub fn payload(&self) -> std::time::Duration { std::time::Duration::from_millis(37) } }
    impl std::fmt::Display for SampleError {
        fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
            match self {
                Self::Failure { message, .. } => write!(formatter, "service_failure: blocked: {message}"),
                Self::Empty => formatter.write_str("empty operation"),
            }
        }
    }
}
