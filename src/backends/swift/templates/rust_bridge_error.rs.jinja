{% for variant in error.variants %}
        {{ variant.pattern }} => {
{% for field in variant.fields %}
            if let Ok(value) = serde_json::to_string({{ field.binding }}) {
                payload.insert({{ field.key }}.to_string(), value);
            }
{% endfor %}
            "{{ variant.name }}"
        },
{% endfor %}
