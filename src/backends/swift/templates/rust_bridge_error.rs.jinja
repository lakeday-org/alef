/// Build the bridge error for `error`. The core error types give their kind, status and retry
/// delay, also when a stream or a boxed error holds them; any other error gives its message only.
pub fn alef_bridge_error<E: std::fmt::Display + 'static>(error: E) -> AlefBridgeError {
    let message = error.to_string();
    let any: &dyn std::any::Any = &error;
    let boxed_sync = any.downcast_ref::<Box<dyn std::error::Error + Send + Sync + 'static>>();
    let boxed = any.downcast_ref::<Box<dyn std::error::Error + 'static>>();
{% for error in errors %}
    if let Some(e) = any.downcast_ref::<{{ error.rust_path }}>() {
        return alef_bridge_error_{{ error.snake }}(message, e);
    }
    if let Some(e) = boxed_sync.and_then(|b| b.downcast_ref::<{{ error.rust_path }}>()) {
        return alef_bridge_error_{{ error.snake }}(message, e);
    }
    if let Some(e) = boxed.and_then(|b| b.downcast_ref::<{{ error.rust_path }}>()) {
        return alef_bridge_error_{{ error.snake }}(message, e);
    }
{% endfor %}
    let _ = (boxed_sync, boxed);
    AlefBridgeError::from(message)
}
