/// Error returned by every fallible bridge call. Swift receives it as a thrown value and
/// converts it into the typed Swift error. `kind` is the variant name of the core error,
/// `status` its HTTP status and `retry_after_ms` its retry delay. A text field is empty and a number
/// is `-1` when the error does not carry it, for example an error that does not come from the
/// core crate.
pub struct AlefBridgeError {
    message: String,
    error_type: String,
    kind: String,
    status: i32,
    retry_after_ms: i64,
    payload: std::collections::BTreeMap<String, String>,
}

impl AlefBridgeError {
    pub fn message(&self) -> String {
        self.message.clone()
    }

    pub fn error_type(&self) -> String {
        self.error_type.clone()
    }

    pub fn payload(&self) -> String {
        serde_json::to_string(&self.payload).expect("error payload contains only strings")
    }

    pub fn kind(&self) -> String {
        self.kind.clone()
    }

    pub fn status(&self) -> i32 {
        self.status
    }

    pub fn retry_after_ms(&self) -> i64 {
        self.retry_after_ms
    }
}

impl From<String> for AlefBridgeError {
    fn from(message: String) -> Self {
        AlefBridgeError {
            message,
            error_type: String::new(),
            kind: String::new(),
            status: -1,
            retry_after_ms: -1,
            payload: std::collections::BTreeMap::new(),
        }
    }
}

impl From<&str> for AlefBridgeError {
    fn from(message: &str) -> Self {
        AlefBridgeError::from(message.to_string())
    }
}
