package sample
import "testing"
func TestPolicy(t *testing.T) {
    for _, visitor := range []bool{false, true} {
        var options *RenderOptions
        if visitor { options = &RenderOptions{Renderer: struct{}{}} }
        for _, enabled := range []bool{false, true} {
            name := "plain"; if visitor { name = "visitor" }
            flag := "false"; if enabled { flag = "true" }
            t.Run(name+"_"+flag, func(t *testing.T) {
                before := callbackCount
                result, err := RenderWithPolicy("input", enabled, options)
                if err != nil { t.Fatal(err) }
                if result.Enabled != enabled || result.Visited != visitor { t.Fatalf("unexpected result: %+v", result) }
                expected := 0; if visitor { expected = 1 }
                if callbackCount-before != expected { t.Fatal("native callback path did not run exactly once") }
            })
        }
        name := "default_plain"; if visitor { name = "default_visitor" }
        t.Run(name, func(t *testing.T) {
            result, err := Render("input", options)
            if err != nil { t.Fatal(err) }
            if !result.Enabled || result.Visited != visitor { t.Fatalf("base API changed: %+v", result) }
        })
    }
}
