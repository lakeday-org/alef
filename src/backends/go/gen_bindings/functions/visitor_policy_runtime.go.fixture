import "C"
import (
    "encoding/json"
    "fmt"
    "runtime"
    "unsafe"
)
type Visitor interface{}
type RenderOptions struct { Renderer Visitor `json:"-"` }
type RenderOutput struct { Enabled bool `json:"enabled"`; Visited bool `json:"visited"` }
var callbackCount int
//export goPolicyVisit
func goPolicyVisit() { callbackCount++ }
func registerVisitor(v Visitor) uintptr { return 0 }
func unregisterVisitor(id uintptr) {}
func lastError() error { return nil }
