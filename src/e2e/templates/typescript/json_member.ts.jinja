{% if kind == "map" %}
((value: unknown): unknown => value instanceof Map ? value.get({{ key }}) : undefined)({{ value }})
{% else %}
((value: unknown): unknown => {
    if (value !== null && typeof value === "object" && {{ key }} in value) {
        return value[{{ key }}];
    }
    return undefined;
})({{ value }})
{% endif %}
