    static Envelope Make(int count, string first, string second, bool scalar = false, bool absent = false)
    {
        var pieces = new List<Piece> { {% if enum_elements %}new Piece.Text(first), new Piece.Text(second){% else %}new Piece { Text = first }, new Piece { Text = second }{% endif %} };
        pieces = pieces.Take(count).ToList();
