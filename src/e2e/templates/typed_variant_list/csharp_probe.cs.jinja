    static void Rejected(Action action)
    {
        Assert.ThrowsAny<Xunit.Sdk.XunitException>(action);
    }

    static void Main()
    {
        Check(Make(2, "hello", " world"));
        Rejected(() => Check(Make(1, "hello", " world")));
        Rejected(() => Check(Make(2, "wrong", " world")));
        Rejected(() => Check(Make(2, "hello", "wrong")));
        Rejected(() => Check(Make(2, "hello", " world", true)));
        Rejected(() => Check(Make(2, "hello", " world", absent: true)));
