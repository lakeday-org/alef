void main() {
  test('correct count and both exact texts', () => checkResult(makeResult(2, 'hello', ' world')));
  test('wrong count is rejected', () => expect(() => checkResult(makeResult(1, 'hello', ' world')), throwsA(isA<TestFailure>())));
  test('wrong first text is rejected', () => expect(() => checkResult(makeResult(2, 'wrong', ' world')), throwsA(isA<TestFailure>())));
  test('wrong second text is rejected', () => expect(() => checkResult(makeResult(2, 'hello', 'wrong')), throwsA(isA<TestFailure>())));
  test('null payload is rejected', () => expect(() => checkResult(makeResult(2, 'hello', ' world', absent: true)), throwsA(isA<TestFailure>())));
  test('wrong variant is rejected', () => expect(() => checkResult(makeResult(2, 'hello', ' world', scalar: true)), throwsA(isA<TestFailure>())));
}
